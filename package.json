{
  "name": "@vercel-labs/migration-control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript control plane for planning and verifying migrations to Vercel.",
  "license": "MIT",
  "bin": {
    "vercel-migrate": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "npm run build --silent && node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
